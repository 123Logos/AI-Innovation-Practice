# ========================================
# 环境标识
# ========================================
# 生产部署必须保持为 production；本地开发可复制后改为 development
ENVIRONMENT=development
APP_NAME=ai-career-platform
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ========================================
# 数据库
# ========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=resume_mvp_dev
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/resume_mvp_dev?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/resume_mvp_test?charset=utf8mb4

# ========================================
# JWT
# 生产环境必须使用至少 32 位的强随机值
# ========================================
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
ENABLE_UUID_AUTH=0

# ========================================
# 前端访问地址
# ========================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ========================================
# DeepSeek 模型服务配置（ADR-009：BYOK）
# ========================================
# 真实调用已启用，但 Key **不由服务端配置**：用户在「AI 设置」里填入自己的 Key，
# 前端每次生成时用 X-DeepSeek-Key 请求头带上；服务端只在本次请求的内存里持有，
# 不落库、不写日志。因此 DEEPSEEK_API_KEY 不再被任何代码读取，保留这一行只是
# 兼容旧 .env（Settings 用 extra="ignore"，删掉也不报错）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 下面三项的实际取值固定在 app/integrations/copy_writer.py（deepseek-flash / 30s /
# thinking=disabled）。写在这里是给人看的说明，改这一行不会改变程序行为。
# 注意：deepseek-chat 与 deepseek-reasoner 两个旧模型名已于 2026-07-24 停用。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENCY=5

# ========================================
# Redis / 异步任务
# ========================================
REDIS_URL=redis://127.0.0.1:6379/0

# ========================================
# S3 对象存储
# ========================================
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=career-platform-private

# ========================================
# 文件上传与安全
# ========================================
MAX_UPLOAD_MB=10
ACCESS_TOKEN_COOKIE_SECURE=0
ENABLE_API_DOCS=1

# ========================================
# 接口限流（T7.7）
# 登录/注册按客户端 IP 限制 5 次/分钟；置 false 可整体关闭（自动化测试用）
# ========================================
RATE_LIMIT_ENABLED=true
