# ========================================
# 环境标识
# ========================================
# 生产部署必须保持为 production；本地开发可复制后改为 development
ENVIRONMENT=development
APP_NAME=ai-career-platform
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ========================================
# 数据库
# ========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=dbname
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/dbname?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/dbname_test?charset=utf8mb4

# ========================================
# JWT
# 生产环境必须使用至少 32 位的强随机值
# ========================================
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
ENABLE_UUID_AUTH=0

# ========================================
# 前端访问地址
# ========================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ========================================
# DeepSeek 模型服务配置
# ========================================
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=5

# ========================================
# Redis / 异步任务
# ========================================
REDIS_URL=redis://127.0.0.1:6379/0

# ========================================
# S3 对象存储
# ========================================
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=career-platform-private

# ========================================
# 文件上传与安全
# ========================================
MAX_UPLOAD_MB=10
ACCESS_TOKEN_COOKIE_SECURE=0
ENABLE_API_DOCS=1
