# Never built on the development host (no Docker installed — ADR-008). The backend
# image has since been built and run once on the owner's Ubuntu 22.04 server
# (2026-11-17, see ADR-008's round 32–33 revision). Whether THIS image was built there
# is not recorded — the API requests in `logs web` carry real client IPs, which is also
# consistent with a host-level reverse proxy serving the SPA itself. Until someone says
# otherwise, treat it as a deployment-ready draft, not as a working deployment.

FROM node:22-alpine AS build

WORKDIR /app

# Same major version CI and local development use.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# `npm run build` runs `vue-tsc --noEmit` first, so a type error fails the image build.
RUN npm run build

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1/index.html"]
