# NOT VERIFIED: Docker is not installed on the development host.
# See docs/adr/ADR-008-docker-configs-unverified.md. This image has never been built;
# treat it as a deployment-ready draft, not as a working deployment.

FROM node:22-alpine AS build

WORKDIR /app

# Same major version CI and local development use.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# `npm run build` runs `vue-tsc --noEmit` first, so a type error fails the image build.
RUN npm run build

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1/index.html"]
