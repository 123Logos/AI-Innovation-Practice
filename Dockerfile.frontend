# Built as part of the full production stack on the owner's Aliyun ECS (Ubuntu 22.04)
# on 2026-11-17: after the round 32–34 fixes the owner rebuilt every service and
# confirmed the acceptance checks passed, with the UI served through this nginx image
# (the prod compose publishes it on :80). The DEV host still has no Docker, so it was
# never built on the development machine. What is NOT separately recorded: a
# step-by-step verification of this image in isolation (e.g. its own HEALTHCHECK).

FROM node:22-alpine AS build

WORKDIR /app

# Same major version CI and local development use.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# `npm run build` runs `vue-tsc --noEmit` first, so a type error fails the image build.
RUN npm run build

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1/index.html"]
